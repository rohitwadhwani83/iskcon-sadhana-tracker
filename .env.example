# ==============================================================================
# ISKCON SĀDHANA TRACKER — ENVIRONMENT CONFIGURATION (.env.example)
# ZERO-COST ARCHITECTURE: GITHUB + VERCEL HOBBY + FIREBASE SPARK TIER (₹0/MONTH)
# ==============================================================================
# IMPORTANT:
# 1. Do not commit actual credentials to Git.
# 2. Use a dedicated Firebase project: DO NOT reuse the Yatra Management App project.
# 3. Leave the Firebase Spark plan on the free tier (do not upgrade to Blaze plan).
# ==============================================================================

# Client-Side Firebase Configuration (Cloud Firestore + Firebase Auth)
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyYourProjectApiKeyHere123456789
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=iskcon-sadhana-tracker.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=iskcon-sadhana-tracker
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=iskcon-sadhana-tracker.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789012
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890

# Server-Side / Administrative CLI Configuration (For scripts/provision-superadmin.mjs)
# Never expose these in client bundles or public git repositories.
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/serviceAccountKey.json
# FIREBASE_ADMIN_PROJECT_ID=iskcon-sadhana-tracker
# FIREBASE_ADMIN_CLIENT_EMAIL=firebase-adminsdk-xxxxx@iskcon-sadhana-tracker.iam.gserviceaccount.com
# FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
